{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DramaDist",
  "version": "0.1.0",
  "identifier": "com.dramadist.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DramaDist · 短剧切片分发工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DramaDist",
    "category": "Video",
    "resources": ["resources/*", "resources/bin/*", "resources/asr_runtime/**/*"],
    "shortDescription": "短剧切片分发工作台",
    "longDescription": "DramaDist 是一款纯本地的短剧素材处理与分发工具：导入长剧素材，自动切片、生成字幕轴、导出成片。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "compression": "lzma",
        "startMenuFolder": "DramaDist"
      }
    }
  }
}
